    "Add friends by username, link or QR code. Every friend gets a chat, and every squad gets one too.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade amigos por nombre de usuario, enlace o código QR. Cada amigo y cada grupo tiene su chat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione amigos pelo nome de usuário, link ou QR code. Cada amigo e cada grupo ganha uma conversa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi amici con nome utente, link o codice QR. Ogni amico e ogni gruppo ha la sua chat."
          }
        }
      }
    },
    "Add friends first; you can also invite people with a squad link later.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade amigos primero; también puedes invitar con un enlace de grupo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione amigos primeiro; você também pode convidar com um link do grupo depois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima gli amici; puoi anche invitare con un link di gruppo più tardi."
          }
        }
      }
    },
