    "Ban this account? Their reported content is removed and they’re signed out everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Bloquear esta cuenta? Se retira su contenido denunciado y se cierra su sesión en todas partes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Banir esta conta? O conteúdo denunciado é removido e a sessão é encerrada em todos os aparelhos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bannare questo account? I contenuti segnalati vengono rimossi e viene disconnesso ovunque."
          }
        }
      }
    },
    "Bans": {
