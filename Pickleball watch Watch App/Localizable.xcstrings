    "The knockout starts when every pool match is in.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminatoria empieza cuando estén todos los partidos de grupo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mata-mata começa quando todas as partidas dos grupos terminarem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eliminazione diretta inizia quando tutte le partite dei gironi sono concluse."
          }
        }
      }
    },
    "They won’t be able to message you, see your Serves or call you out. They aren’t told.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podrá escribirte, ver tus publicaciones ni retarte. No se le avisa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa não poderá enviar mensagens, ver seus posts ou desafiar você. Ela não é avisada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potrà scriverti, vedere i tuoi post o sfidarti. Non viene avvisato."
          }
        }
      }
    },
    "This Serve is gone": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta publicación ya no está"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este post não existe mais"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo post non c’è più"
          }
        }
      }
    },
    "This may be sensitive": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ser sensible"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser sensível"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere sensibile"
          }
        }
      }
    },
    "This permanently deletes your profile, friends, chats, Serves, Replays and trophies. Matches stay in your opponents’ history under “Former player”.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra para siempre tu perfil, amigos, chats, publicaciones, Repeticiones y trofeos. Los partidos siguen en el historial de tus rivales como «Exjugador»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga para sempre seu perfil, amigos, conversas, posts, Replays e troféus. As partidas continuam no histórico dos adversários como “Ex-jogador”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina per sempre profilo, amici, chat, post, Replay e trofei. Le partite restano nello storico degli avversari come “Ex giocatore”."
          }
        }
      }
    },
    "This will permanently delete all match history, watch sessions, saved tournaments, and your profile. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará para siempre el historial, las sesiones del reloj, los torneos y tu perfil. No se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apagará para sempre o histórico, as sessões do relógio, os torneios e seu perfil. Não dá para desfazer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo eliminerà per sempre storico, sessioni del Watch, tornei e profilo. Non si può annullare."
          }
        }
      }
    },
