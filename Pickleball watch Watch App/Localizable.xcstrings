    "A guest who signs up with their link gets every match you played together, and becomes your friend.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un invitado que se registre con su enlace recibe todos los partidos que jugasteis juntos y se convierte en tu amigo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um convidado que se cadastrar com o link recebe todas as partidas que vocês jogaram juntos e vira seu amigo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ospite che si iscrive con il suo link riceve tutte le partite giocate insieme e diventa tuo amico."
          }
        }
      }
    },
    "A haptic rhythm only squadmates can send during live matches.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritmo háptico que solo tu grupo puede enviar durante los partidos en directo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ritmo háptico que só o seu grupo pode enviar durante partidas ao vivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritmo aptico che solo il tuo gruppo può inviare durante le partite in diretta."
          }
        }
      }
    },
    "A match from before the update couldn’t be moved.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo trasladar un partido de antes de la actualización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover uma partida de antes da atualização."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile spostare una partita precedente all'aggiornamento."
          }
        }
      }
    },
    "A random install ID, your region setting, language and app version once a day, and crash reports from iOS. Never linked to your account, never used for ads, never sold.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un identificador de instalación aleatorio, tu región, idioma y versión de la app una vez al día, y los informes de fallos de iOS. Nunca vinculado a tu cuenta, nunca para anuncios, nunca vendido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um identificador de instalação aleatório, sua região, idioma e versão do app uma vez por dia, e relatórios de falhas do iOS. Nunca ligado à sua conta, nunca usado para anúncios, nunca vendido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un identificativo di installazione casuale, area geografica, lingua e versione dell’app una volta al giorno, e i rapporti sugli arresti di iOS. Mai collegato al tuo account, mai usato per pubblicità, mai venduto."
          }
        }
      }
    },
    "A result needs you": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resultado te espera"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um resultado precisa de você"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un risultato ti aspetta"
          }
        }
      }
    },
    "A squad match counts for the squad belt and shows up in the squad chat.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un partido de grupo cuenta para el cinturón del grupo y aparece en su chat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma partida do grupo vale para o cinturão do grupo e aparece no chat dele."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una partita di gruppo conta per la cintura del gruppo e appare nella sua chat."
          }
        }
      }
    },
