    "Score on your Watch or phone, or type it in after. The other side confirms, so every result counts.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota en el reloj o el móvil, o escríbelo después. El otro lado confirma, así que cada resultado cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque no relógio ou no celular, ou digite depois. O outro lado confirma, então todo resultado vale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna dal Watch o dal telefono, o inseriscilo dopo. L’altra parte conferma, così ogni risultato conta."
          }
        }
      }
    },
    "Score on your Watch or type it in later. Friends confirm every result, and the Belt goes to whoever beats the holder.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota en el reloj o escríbelo después. Tus amigos confirman cada resultado y el cinturón es para quien gane al que lo lleva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque no relógio ou digite depois. Os amigos confirmam cada resultado, e o cinturão fica com quem vencer quem o tem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna dal Watch o inseriscilo dopo. Gli amici confermano ogni risultato e la cintura va a chi batte chi la detiene."
          }
        }
      }
    },
    "Score only": {
      "extractionState": "manual",
