<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to PickleBall/Secrets.plist and fill in your Supabase
  project's URL and anon (public) key from Project Settings → API.
  PickleBall/Secrets.plist is git-ignored; never commit real keys.
-->
<plist version="1.0">
<dict>
	<key>SUPABASE_URL</key>
	<string>https://YOUR-PROJECT.supabase.co</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>YOUR-ANON-KEY</string>
	<!-- The public web site (web/ on Cloudflare Pages): live scoreboards,
	     invite links, privacy policy, terms and support. -->
	<key>SITE_URL</key>
	<string>https://YOUR-PROJECT.pages.dev</string>
	<!-- Optional: a different invite landing page (defaults to SITE_URL/invite/). -->
	<key>INVITE_PAGE_URL</key>
	<string></string>
</dict>
</plist>
